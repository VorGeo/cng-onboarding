// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "R Tutorial (download)",
	"dockerComposeFile": ["../../docker-compose.yml", "docker-compose.codespaces.yml"],
	"service": "tutorial-r-service",
  "shutdownAction": "none",
  "workspaceFolder": "/workspace/tutorials/stac/r/r-download",

	// Make the container name and service name available to the container.
	"containerEnv": {
		"CONTAINER_NAME": "R Tutorial (download)",
		"SERVICE_NAME": "tutorial-r-service"
	},


	"features": {
		// See: https://containers.dev/features
		"ghcr.io/devcontainers-extra/features/curl-apt-get:1": {
			"version": "1.0.17"
		}
	},

	// Install pixi, use it to install dependencies, and create a kernel for Jupyter.
	"postCreateCommand": "/workspace/.devcontainer/postCreateCommands_R.sh",

	// Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
				"ms-python.python",
				"ms-toolsai.jupyter",
				"charliermarsh.ruff"
			]
    }
  }
}